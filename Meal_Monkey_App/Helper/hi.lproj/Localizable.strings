// About
"8461_about_txt1" = "हमारा मिशन एक सरल और सहज शॉपिंग अनुभव प्रदान करना है जो उपयोगकर्ता की संतुष्टि को प्राथमिकता देता है। हमारी आसान यूज़र इंटरफ़ेस और विश्वसनीय सेवाओं के कारण ब्राउज़िंग, खरीदारी और उत्पाद प्रबंधन आसान महसूस करने वाला प्लेटफ़ॉर्म बनाने का प्रयास करते हैं।";
"8461_about_txt2" = "हम दक्षता, पारदर्शिता और विश्वास के उच्च मानकों को बनाए रखने के लिए प्रतिबद्ध हैं। हमारी टीम लगातार एप्लिकेशन की कार्यक्षमता सुधारने, डेटा गोपनीयता सुनिश्चित करने और प्रतिक्रिया-क्षम ग्राहक समर्थन प्रदान करने पर काम कर रही है।";
"8461_about_txt3" = "आपकी प्रतिक्रिया महत्वपूर्ण है। यदि आपके पास कोई प्रश्न, सुझाव हैं या किसी समस्या का सामना करना पड़ रहा है, तो हम मदद के लिए यहाँ हैं।";
"8461_about_txt4" = "हम मानते हैं कि तकनीक सार्वजनिक सेवा के लिए होनी चाहिए। इसलिए हम हमेशा उपयोगकर्ता की वास्तविक ज़रूरतों और व्यवहार के आधार पर अपने प्लेटफ़ॉर्म को सुधारते हैं।";
"8461_about_txt5" = "सुरक्षा हमारी प्राथमिकता है। हम आपके व्यक्तिगत डेटा की सुरक्षा के लिए उद्योग मानक प्रोटोकॉल का उपयोग करते हैं और हमेशा सुरक्षित शॉपिंग वातावरण प्रदान करते हैं।";
"8461_about_txt6" = "हम पहुँच और समानता को महत्व देते हैं। हमारा प्लेटफ़ॉर्म सभी पृष्ठभूमि, उपकरण और तकनीकी क्षमताओं वाले लोगों द्वारा उपयोग किया जा सकता है।";
"8461_about_txt7" = "हमें स्थिरता महत्वपूर्ण है। हम पर्यावरण के अनुकूल व्यवसायिक प्रथाओं का समर्थन करते हैं और पर्यावरणीय प्रभाव कम करने के लिए साझेदारों के साथ काम करते हैं।";

